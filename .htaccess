Options -Indexes

RewriteEngine On
RewriteBase /

# Canonical: resolve duplicate /home -> /
RewriteRule ^home/?$ / [R=301,L]

# Canonical host + HTTPS (keep localhost/dev untouched)
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Dynamic machine-readable endpoints
RewriteRule ^sitemap\.xml$ api/sitemap.php [L,QSA]
RewriteRule ^llms\.txt$ api/llms.php [L,QSA]
RewriteRule ^updates\.xml$ api/updates-feed.php [L,QSA]
RewriteRule ^rmrp\.xml$ api/rmrp-feed.php [L,QSA]
RewriteRule ^blog\.xml$ api/blog-feed.php [L,QSA]

# Normalize /index
RewriteRule ^index/?$ / [R=301,L]

# WebAssembly: serve yunobot brain.wasm with the correct MIME type
<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

# Block sensitive files (htaccess itself excluded so Apache can read it)
<FilesMatch "^(\.env|\.env\.example|composer\.(json|lock)|phpunit\.xml|\.gitignore|env\.clone|\.ftpquota|\.user\.ini)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log|bak|ini|sh|phar|lock|dist|yml|yaml|sqlite|sqlite3|db|jsonl)$">
    Require all denied
</FilesMatch>
# Block debug, development, and utility files
<FilesMatch "^(debug(_[a-z0-9_-]+)?|gallerymaster|galleryrequests|get_math_token)\.(php|txt|sh)$">
    Require all denied
</FilesMatch>
# Block runtime data files (error logs may contain session IDs and must never be public)
<FilesMatch "^(csrf_log|login_attempts|rate_limit_storage|error_log|sessionlog)\.(txt|json|log)$">
    Require all denied
</FilesMatch>
RewriteRule ^(config|dev|includes|middleware|models|router|scripts|\.git|\.codex|\.agents|\.agent_memory|\.pi|\.kilo|\.agent-logs|\.claude|\.qwen|\.backup|_backups)/ - [F,L,NC]

# Prevent HTTP verb abuse
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)$ [NC]
RewriteRule .* - [F,L]

# LiteSpeed cache hardening — bypass cache for authenticated sessions
<IfModule LiteSpeed>
    RewriteCond %{HTTP_COOKIE} PHPSESSID [OR]
    RewriteCond %{HTTP_COOKIE} user_token [OR]
    RewriteCond %{HTTP_COOKIE} admin_logged_in
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# Upload directory protection — prevent PHP execution
RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
RewriteRule \.(php|phtml|php3|php4|php5|php7|php8|phar)$ - [F,L]

# Admin + admin API responses are session/CSRF sensitive — never cache
# (browser back/forward cache or a proxy serving stale HTML caused stale
# CSRF tokens and "session expired" loops on mobile).
RewriteCond %{REQUEST_URI} ^/(admin|api/admin)(/|$)
RewriteRule ^ - [E=YEV_ADMIN_NO_CACHE:1]

# Search results are thin, near-duplicate and unbounded (?q=...) — keep them out
# of the index without cutting the links they carry.
RewriteCond %{REQUEST_URI} ^/search(?:/|$)
RewriteRule ^ - [E=YEV_NOINDEX:1]

# favicon.ico legacy — browsers always probe /favicon.ico regardless of link
# tags; redirect to THE one favicon so they can never settle on a different file.
RewriteRule ^favicon\.ico$ assets/images/favicon.svg [L,R=302]

# Route app requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Robots-Tag "noindex,follow" env=YEV_NOINDEX
    Header always set X-Robots-Tag "noindex,nofollow" env=YEV_ADMIN_NO_CACHE
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cache-Control "no-cache, no-store, must-revalidate" env=YEV_ADMIN_NO_CACHE
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set Content-Security-Policy "default-src 'self'; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://code.jquery.com https://unpkg.com https://cdnjs.cloudflare.com https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com https://mc.yandex.com https://mc.yandex.ru https://gor.bio https://tenor.com; img-src 'self' data: blob: https://basemaps.cartocdn.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://www.google-analytics.com https://mc.yandex.com https://mc.yandex.ru https://yandex.ru https://*.yandex.ru https://*.yandex.com https://img.youtube.com https://tenor.com https://media.tenor.com https://*.google-analytics.com https://*.doubleclick.net https://googleads.g.doubleclick.net https://cm.g.doubleclick.net https://gumroad.com https://*.gumroad.com; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.xethub.hf.co https://cdn.jsdelivr.net https://unpkg.com https://cdnjs.cloudflare.com https://basemaps.cartocdn.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://www.google-analytics.com https://mc.yandex.com https://mc.yandex.ru https://region1.google-analytics.com https://region1.googletagmanager.com https://gor.bio https://tenor.com https://media.tenor.com wss://mc.yandex.com wss://mc.yandex.ru https://api.allorigins.win https://corsproxy.io https://api.codetabs.com https://r.jina.ai; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com https://odysee.com https://mc.yandex.com https://mc.yandex.ru https://tenor.com https://media.tenor.com; frame-ancestors 'none';"
</IfModule>

ErrorDocument 403 /403.php
ErrorDocument 404 /404
ErrorDocument 500 /500.php
